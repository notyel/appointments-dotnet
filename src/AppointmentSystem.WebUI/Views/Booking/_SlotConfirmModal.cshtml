<div class="scm-backdrop" id="slotConfirmModal" role="dialog" aria-modal="true" aria-labelledby="scmTitle">
    <div class="scm-dialog">
        <div class="scm-icon">
            <span class="material-symbols-outlined">schedule</span>
        </div>
        <p class="scm-title" id="scmTitle">¿Confirmar esta hora?</p>
        <div class="scm-badges">
            <span class="scm-badge scm-badge--date" id="scmDateBadge">—</span>
            <span class="scm-badge scm-badge--time" id="scmTimeBadge">—</span>
        </div>
        <p class="scm-body">¿Desea continuar con este horario para su cita?</p>
        <div class="scm-actions">
            <button type="button" class="scm-btn scm-btn--cancel" id="scmCancel">Cambiar hora</button>
            <button type="button" class="scm-btn scm-btn--confirm" id="scmConfirm">Confirmar</button>
        </div>
    </div>
</div>

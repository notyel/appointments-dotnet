@model IEnumerable<AppointmentSystem.Application.DTOs.ServiceDto>
@{
    ViewData["Title"] = "Seleccione un Servicio";
    ViewBag.CurrentStep = 2;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400&icon_names=schedule,bolt,arrow_back,check_circle,local_fire_department" rel="stylesheet" />
}

<div class="content">
    <partial name="_BookingStepper" />
</div>

<div class="content">
    <div class="step-header">
        <h1 class="step-title">Servicios Disponibles</h1>
        <p class="step-description">Elige el servicio que deseas reservar</p>
    </div>

    <div class="booking-two-col">
        <div class="booking-main-col">
            <div class="options-grid">
                @foreach (var service in Model)
                {
                    <div class="option-card">
                        @* Imagen / placeholder con badges *@
                        <div class="option-card-image @(string.IsNullOrEmpty(service.ImageUrl) ? "option-card-image-placeholder" : "")">
                            @if (!string.IsNullOrEmpty(service.ImageUrl))
                            {
                                <img src="@service.ImageUrl" alt="@service.Name"
                                     onerror="this.parentElement.classList.add('option-card-image-placeholder'); this.remove()" />
                            }
                            @* Etiqueta de categoría — esquina superior izquierda *@
                            <span class="option-card-tag">@service.Category</span>
                            @* Badge Popular — esquina superior derecha *@
                            @if (service.IsPopular)
                            {
                                <span class="option-card-popular">
                                    <span class="material-symbols-outlined">local_fire_department</span>
                                    Popular
                                </span>
                            }
                            @* Precio — esquina inferior derecha *@
                            <span class="option-card-price-badge">@service.FormattedPrice</span>
                        </div>
                        <div class="option-card-content">
                            @* Título + duración + categoría inline *@
                            <div class="option-card-header">
                                <h3 class="option-card-title">@service.Name</h3>
                            </div>
                            <div class="option-card-meta">
                                <div class="option-card-meta-item">
                                    <span class="material-symbols-outlined option-card-meta-icon">schedule</span>
                                    <span>@service.DurationMinutes min</span>
                                </div>
                                <div class="option-card-meta-item">
                                    <span class="material-symbols-outlined option-card-meta-icon">bolt</span>
                                    <span>@service.Category</span>
                                </div>
                            </div>
                            <div class="option-card-body">
                                <p class="option-card-text">@service.Description</p>
                            </div>
                            <div class="option-card-footer">
                                <a asp-controller="Booking" asp-action="Professionals"
                                   asp-route-branchId="@ViewBag.BranchId"
                                   asp-route-branchServiceId="@service.Id"
                                   class="btn btn-primary btn-block">
                                    <span class="material-symbols-outlined">check_circle</span>
                                    Seleccionar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="booking-summary-col">
            <partial name="_BookingSummary" />
        </aside>
    </div>

    <div class="step-navigation">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <span class="material-symbols-outlined">arrow_back</span>
            <span>Volver a Sucursales</span>
        </a>
        <div></div>
    </div>
</div>

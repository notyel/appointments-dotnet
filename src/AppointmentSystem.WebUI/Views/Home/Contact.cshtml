@{
    ViewData["Title"] = "Contacto";
    var config = ViewBag.AppConfig as AppointmentSystem.WebUI.Models.AppConfig;
    string businessName = ViewBag.BusinessName ?? "Sistema de Citas";
    var hero = new AppointmentSystem.WebUI.Models.HeroViewModel
    {
        Title    = "Contacto",
        Subtitle = "Estamos aqui para ayudarte. Comunicate con nosotros a traves de cualquiera de estos medios.",
        Height   = "260px"
    };
}

<partial name="_Hero" model="hero" />

<div class="content">
    <div class="contact-cards">
        <div class="contact-card">
            <div class="contact-icon">
                <span class="material-symbols-outlined">phone</span>
            </div>
            <h3>Telefono</h3>
            <p>@config?.Contact.Phone</p>
        </div>

        <div class="contact-card">
            <div class="contact-icon">
                <span class="material-symbols-outlined">mail</span>
            </div>
            <h3>Correo Electronico</h3>
            <p>@config?.Contact.Email</p>
        </div>

        <div class="contact-card">
            <div class="contact-icon">
                <span class="material-symbols-outlined">location_on</span>
            </div>
            <h3>Direccion</h3>
            <p>@config?.Contact.Address</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .contact-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--spacing-xl);
            margin: var(--spacing-2xl) 0;
        }

        .contact-card {
            background: white;
            border-radius: var(--radius-xl);
            padding: var(--spacing-2xl);
            text-align: center;
            box-shadow: var(--shadow-md);
            transition: all var(--transition-base);
        }

        .contact-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .contact-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto var(--spacing-xl);
            background: var(--gradient-primary);
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .contact-icon .material-symbols-outlined {
            font-size: var(--font-size-3xl);
            color: white;
        }

        .contact-card h3 {
            color: var(--color-text);
            font-size: var(--font-size-xl);
            margin-bottom: var(--spacing-sm);
            font-weight: var(--font-weight-semibold);
        }

        .contact-card p {
            color: var(--color-text-secondary);
            font-size: var(--font-size-base);
            line-height: 1.6;
        }

        @@media (max-width: 768px) {
            .contact-cards {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
